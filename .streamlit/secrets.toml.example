# Copie este arquivo para .streamlit/secrets.toml e preencha os valores
# NAO faça commit do secrets.toml — ele fica apenas no Streamlit Cloud

# Brave Search API (gratuito: 2000 queries/mês, sem cartão)
# 1. Crie conta em: https://api.search.brave.com
# 2. Escolha o plano Free
# 3. Copie a API key
BRAVE_SEARCH_API_KEY = "BSA..."

# Anthropic API (Claude) — para scoring inteligente via IA
# 1. Acesse: https://console.anthropic.com/settings/keys
# 2. Crie uma API key
# Usa Claude Haiku (muito barato: ~$0.001 por lead analisado)
ANTHROPIC_API_KEY = "sk-ant-..."

# Hunter.io — enriquecimento de email (25 buscas/mês grátis)
# 1. Crie conta em: https://hunter.io
# 2. Copie a API key em: https://hunter.io/api-keys
HUNTER_API_KEY = "..."

# Gmail SMTP — para envio de email follow-up (opcional)
# Use uma "App Password" do Google (não sua senha real)
# https://myaccount.google.com/apppasswords
GMAIL_USER = "seu@gmail.com"
GMAIL_APP_PASSWORD = "xxxx xxxx xxxx xxxx"

# Cole o conteudo completo do google_token.json aqui (gerado apos 1o login)
GOOGLE_TOKEN_JSON = '''
{
  "token": "...",
  "refresh_token": "...",
  ...
}
'''
